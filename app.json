{
  "expo": {
    "name": "gym-journey-expo",
    "slug": "gym-journey-expo",
    "owner": "hassanrashid0019",
    "scheme": "gymjourney",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mobapplogo.png",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "backgroundColor": "#0D0D0D",
      "barStyle": "light-content",
      "translucent": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hassanrashid0019.gymjourney",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Forge Gym uses Face ID to verify your identity for two-factor authentication.",
        "NSLocationWhenInUseUsageDescription": "Forge uses your location to verify gym check-in."
      }
    },
    "android": {
      "package": "com.hassanrashid0019.gymjourney",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/mobapplogo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "FORGE",
      "shortName": "FORGE",
      "description": "FORGE — Train. Build. Become.",
      "themeColor": "#0D0D0D",
      "backgroundColor": "#0D0D0D",
      "display": "standalone",
      "startUrl": "/"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Forge Gym to use Face ID for two-factor authentication."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Forge to use your location for gym check-in."
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "45311505-8e2c-4a1b-b73d-726c2db149fe"
      }
    }
  }
}
