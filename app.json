{
  "expo": {
    "name": "gym-journey-expo",
    "slug": "gym-journey-expo",
    "owner": "hassanrashid0019",
    "scheme": "gymjourney",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hassanrashid0019.gymjourney",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Forge Gym uses Face ID to verify your identity for two-factor authentication."
      }
    },
    "android": {
      "package": "com.hassanrashid0019.gymjourney",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "statusBar": {
        "backgroundColor": "#0D0D0D",
        "barStyle": "light-content",
        "translucent": false
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Forge Gym to use Face ID for two-factor authentication."
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "45311505-8e2c-4a1b-b73d-726c2db149fe"
      }
    }
  }
}
